{
  "name": "cs2wp-web",
  "version": "0.1.0",
  "private": true,
  "description": "cs2wp website: replays, win probability and map odds vs Kalshi",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
