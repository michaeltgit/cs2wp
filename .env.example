# Copy to the shell (or a .env your tooling loads) to run services on the HOST against the stack.
# Lite mode needs none of this: defaults are local folder + SQLite + in-process bus.
CS2WP_STORAGE=s3
CS2WP_S3_ENDPOINT=http://localhost:9000
CS2WP_DATABASE_URL=postgresql+psycopg://cs2wp:cs2wp@localhost:5432/cs2wp
CS2WP_BUS=kafka
CS2WP_KAFKA_BOOTSTRAP=localhost:19092
AWS_ACCESS_KEY_ID=cs2wp
AWS_SECRET_ACCESS_KEY=cs2wp-local-only
AWS_DEFAULT_REGION=us-east-1
